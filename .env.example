# ---------------------------------------------------------------------------
# Agency Partner Interactive — AI Website Builder
# Copy this file to .env and fill in the values.
# ---------------------------------------------------------------------------

# Database (SQLite via Prisma)
DATABASE_URL="file:./dev.db"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth (Better Auth)
BETTER_AUTH_SECRET="change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
# Optional comma-separated extra origins (production/staging domains)
# BETTER_AUTH_TRUSTED_ORIGINS="https://app.example.com"

# ---------------------------------------------------------------------------
# AI providers (Cursor primary → Gemini fallback → local template)
# ---------------------------------------------------------------------------
CURSOR_API_KEY=""
HEAVY_MODEL_NAME="composer-2.5"
LIGHT_MODEL_NAME="composer-2.5"
# Used automatically when Cursor fails or isn't configured.
GEMINI_API_KEY=""
GEMINI_MODEL_NAME="gemini-2.5-flash"
# When true, skip all AI APIs and use the deterministic local template.
AI_USE_MOCK="false"

# ---------------------------------------------------------------------------
# Credit / token system
# ---------------------------------------------------------------------------
SIGNUP_CREDIT_BONUS="100"
CREDIT_COST_HEAVY_GENERATE="50"
CREDIT_COST_LIGHT_EDIT="5"

# ---------------------------------------------------------------------------
# Stock images (fallback chain: Shutterstock -> Pexels -> Unsplash -> placeholder)
# Used at generation time and in the editor (search Pexels / Shutterstock).
# Users can also upload their own product/service images in the editor.
# ---------------------------------------------------------------------------
SHUTTERSTOCK_API_TOKEN=""
PEXELS_API_KEY=""
UNSPLASH_ACCESS_KEY=""

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# Website package price IDs
STRIPE_SELF_HOSTING_PRICE_ID=""
STRIPE_MANAGED_CREATION_PRICE_ID=""
STRIPE_MANAGED_MONTHLY_PRICE_ID=""
# Credit pack price IDs
STRIPE_CREDIT_PACK_100_PRICE_ID=""
STRIPE_CREDIT_PACK_300_PRICE_ID=""
STRIPE_CREDIT_PACK_1000_PRICE_ID=""

# ---------------------------------------------------------------------------
# GitHub (repos are created private by default, regardless of payment)
# ---------------------------------------------------------------------------
GITHUB_TOKEN=""
GITHUB_ORG=""
GITHUB_REPO_VISIBILITY="private"

# ---------------------------------------------------------------------------
# Deployment (managed hosting -> subdomain)
# ---------------------------------------------------------------------------
DEPLOYMENT_PROVIDER="vercel"
DEPLOYMENT_TOKEN=""
PLATFORM_DOMAIN="agencypartner.site"
