# Copy this file to .env and fill values, or store them with:
#   stripe projects variables set <name> --env-key <KEY>
#   stripe projects env --pull
# Do not commit real secrets. Stripe Projects CLI owns the generated .env.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
ADMIN_EMAILS=admin@admin.com

# --- Domains (Caddy) ---
# App, public media bucket, and the parent domain for published client sites.
# Keep PLATFORM_DOMAIN off the app's own domain so client sites never share its cookies.
DOMAIN=app.example.com
MEDIA_DOMAIN=media.example.com
PLATFORM_DOMAIN=sites.example.com

# --- Database (Postgres) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=website_builder
# Host-side `npm run dev` uses the published localhost port. Compose overrides
# DATABASE_URL and talks to postgres:5432 on the internal network.
# postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@127.0.0.1:5433/<POSTGRES_DB>?schema=public
DATABASE_URL=

# --- Object storage (Garage, S3-compatible) ---
# Generate each secret with: openssl rand -hex 32
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_METRICS_TOKEN=
# Key printed by deploy/garage/init.sh.
# Host `npm run dev` uses the loopback port Compose publishes. The app
# service overrides this to http://garage:3900 inside the stack.
S3_ENDPOINT=http://127.0.0.1:3900
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=media
S3_SITES_BUCKET=sites
# Public origin of the media bucket. Also passed to the Docker build.
S3_PUBLIC_URL=https://media.example.com

# --- SMTP (account verification + owner mail) ---
# Verification is required only when SMTP_HOST and NOTIFY_FROM_EMAIL are both set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM_EMAIL=

# --- AI ---
CURSOR_API_KEY=
HEAVY_MODEL_NAME=claude-opus-5
LIGHT_MODEL_NAME=composer-2.5
CURSOR_TIMEOUT_MS=270000
CURSOR_LIGHT_TIMEOUT_MS=270000
AI_USE_MOCK=false

# --- Credits ---
SIGNUP_CREDIT_BONUS=70
CREDIT_COST_HEAVY_GENERATE=50
CREDIT_COST_LIGHT_EDIT=5
CREDIT_COST_SCRAPE_IMPORT=10

# --- Images ---
SHUTTERSTOCK_API_TOKEN=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
IMAGE_VISION_ENABLED=true
VISION_MODEL_NAME=
IMAGE_VISION_TIMEOUT_MS=90000
IMAGE_VISION_MAX_IMAGES=36

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SELF_HOSTING_PRICE_ID=
STRIPE_MANAGED_CREATION_PRICE_ID=
STRIPE_MANAGED_MONTHLY_PRICE_ID=
STRIPE_CREDIT_PACK_SMALL_PRICE_ID=
STRIPE_CREDIT_PACK_MEDIUM_PRICE_ID=
STRIPE_CREDIT_PACK_LARGE_PRICE_ID=

# --- Billing records ---
# 32 random bytes as base64 (openssl rand -base64 32) or 64 hex chars.
BILLING_ENCRYPTION_KEY=

# --- GitHub (paid site backup) ---
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_SITES_REPO=
GITHUB_REPO_VISIBILITY=private

# --- HubSpot ---
HUBSPOT_API_KEY=
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_API_VERSION=2026-09
HUBSPOT_ASSOCIATIONS_API_VERSION=2026-09
HUBSPOT_DEAL_PIPELINE=
HUBSPOT_LEAD_PIPELINE=
HUBSPOT_LEAD_NEW_STAGE=
HUBSPOT_LEAD_CLOSED_WON_STAGE=
HUBSPOT_LEAD_OWNER_ID=
HUBSPOT_LEAD_SCORE_PROPERTY=lead_score
HUBSPOT_REQUEST_TIMEOUT_MS=15000
HUBSPOT_REQUEST_RETRIES=2
HUBSPOT_MAX_JOB_ATTEMPTS=6

# --- Cron (bearer token the cron container sends) ---
CRON_SECRET=
