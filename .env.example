# Copy this file to .env and fill values, or store them with:
#   stripe projects variables set <name> --env-key <KEY>
#   stripe projects env --pull
# Do not commit real secrets. Stripe Projects CLI owns the generated .env.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
ADMIN_EMAILS=admin@admin.com

# --- Database (Supabase Postgres) ---
DATABASE_URL=
DIRECT_URL=

# --- SMTP (account verification + owner mail) ---
# Verification is required only when SMTP_HOST and NOTIFY_FROM_EMAIL are both set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM_EMAIL=

# --- AI ---
CURSOR_API_KEY=
HEAVY_MODEL_NAME=claude-opus-5
LIGHT_MODEL_NAME=composer-2.5
CURSOR_TIMEOUT_MS=270000
CURSOR_LIGHT_TIMEOUT_MS=270000
AI_USE_MOCK=false

# --- Credits ---
SIGNUP_CREDIT_BONUS=70
CREDIT_COST_HEAVY_GENERATE=50
CREDIT_COST_LIGHT_EDIT=5
CREDIT_COST_SCRAPE_IMPORT=10

# --- Images ---
SHUTTERSTOCK_API_TOKEN=
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
IMAGE_VISION_ENABLED=true
VISION_MODEL_NAME=
IMAGE_VISION_TIMEOUT_MS=90000
IMAGE_VISION_MAX_IMAGES=36

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SELF_HOSTING_PRICE_ID=
STRIPE_MANAGED_CREATION_PRICE_ID=
STRIPE_MANAGED_MONTHLY_PRICE_ID=
STRIPE_CREDIT_PACK_SMALL_PRICE_ID=
STRIPE_CREDIT_PACK_MEDIUM_PRICE_ID=
STRIPE_CREDIT_PACK_LARGE_PRICE_ID=

# --- GitHub (paid site backup) ---
GITHUB_TOKEN=
GITHUB_ORG=
GITHUB_SITES_REPO=
GITHUB_REPO_VISIBILITY=private

# --- Deploy ---
DEPLOYMENT_PROVIDER=vercel
DEPLOYMENT_TOKEN=
DEPLOYMENT_TEAM_ID=
PLATFORM_DOMAIN=

# --- Supabase Storage ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=scraped-assets

# --- HubSpot ---
HUBSPOT_API_KEY=
HUBSPOT_API_BASE_URL=https://api.hubapi.com
HUBSPOT_API_VERSION=2026-09
HUBSPOT_ASSOCIATIONS_API_VERSION=2026-09
HUBSPOT_DEAL_PIPELINE=
HUBSPOT_LEAD_PIPELINE=
HUBSPOT_LEAD_NEW_STAGE=
HUBSPOT_LEAD_CLOSED_WON_STAGE=
HUBSPOT_LEAD_OWNER_ID=
HUBSPOT_LEAD_SCORE_PROPERTY=lead_score
CRON_SECRET=
