# Build output and dependencies are produced inside the image.
.next
node_modules
coverage
out
build
*.tsbuildinfo

# Local data, exports and scratch space.
tmp
tmp-*
public/uploads
generated-projects
prisma/*.db
prisma/*.db-journal
test-results
playwright-report

# Secrets and CLI-managed state never enter the build context.
.env*
.projects
.vercel

# Tooling and editor state.
.git
.claude
.cursor
.agents
.scannerwork
npm-debug.log*

# Deployment files are mounted into their own containers, not built into the app.
deploy
docker-compose.yml
Dockerfile
.dockerignore
