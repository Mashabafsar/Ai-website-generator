{
  "name": "agency-partner-ai-website-builder",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "templates:validate": "ts-node --transpile-only --project templates/tsconfig.validate.json templates/validate.ts",
    "icons:validate": "tsx scripts/validate-icons.ts",
    "templates:locks": "tsx scripts/validate-template-locks.ts",
    "test": "node --import tsx --test tests/*.test.mts",
    "hubspot:verify": "node --env-file-if-exists=.env --import tsx scripts/verify-hubspot.ts",
    "hubspot:backfill": "node --env-file-if-exists=.env --import tsx scripts/backfill-hubspot-leads.ts",
    "hubspot:deals-sample": "node --env-file-if-exists=.env --import tsx scripts/sync-hubspot-deals-sample.ts",
    "accounts:deactivate": "node --env-file-if-exists=.env --import tsx scripts/deactivate-stale-accounts.ts",
    "validate": "npm run templates:validate && npm run icons:validate && npm run templates:locks",
    "admin:grant": "node scripts/set-admin.mjs",
    "sonar": "sonar-scanner-npm"
  },
  "prisma": {
    "seed": "ts-node --project prisma/tsconfig.seed.json prisma/seed.ts"
  },
  "dependencies": {
    "@cursor/sdk": "^1.0.23",
    "@hookform/resolvers": "^3.9.1",
    "@octokit/rest": "^21.0.2",
    "@prisma/client": "^6.2.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.4",
    "@supabase/supabase-js": "^2.116.0",
    "@vercel/analytics": "^2.0.1",
    "archiver": "^7.0.1",
    "better-auth": "^1.1.14",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "motion": "^14.2.0",
    "next": "^15.5.22",
    "next-themes": "^0.4.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sharp": "^0.35.4",
    "sonner": "^1.7.1",
    "stripe": "^22.6.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "prisma": "^6.2.1",
    "sonarqube-scanner": "^5.0.2",
    "tailwindcss": "^4.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}